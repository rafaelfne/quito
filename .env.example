NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave de API da Resend (resend.com, faixa grátis), usada pelo Supabase para mandar o e-mail com o código de entrada
RESEND_API_KEY=
# Endereço que aparece como remetente do e-mail do código, num domínio verificado na Resend (valor comum, ex.: entrar@seudominio)
QUITO_EMAIL_FROM=
# Identificador do cliente OAuth do Google (console.cloud.google.com, Credenciais), usado pelo Supabase no botão Entrar com Google
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# Segredo do mesmo cliente OAuth do Google (console.cloud.google.com, Credenciais), usado pelo Supabase no botão Entrar com Google
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
