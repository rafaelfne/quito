NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave de API da Resend (resend.com, faixa grátis), usada pelo Supabase para mandar o e-mail com o código de entrada
RESEND_API_KEY=
# Endereço que aparece como remetente do e-mail do código, num domínio verificado na Resend (valor comum, ex.: entrar@seudominio)
QUITO_EMAIL_FROM=
# Identificador do cliente OAuth do Google (console.cloud.google.com, Credenciais), usado pelo Supabase no botão Entrar com Google
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# Segredo do mesmo cliente OAuth do Google (console.cloud.google.com, Credenciais), usado pelo Supabase no botão Entrar com Google
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
# Chave pública VAPID (segredo gerado em par com a chave privada, por exemplo com npx web-push generate-vapid-keys), usada pelo navegador para inscrever o aparelho nas notificações
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Chave service_role do Supabase (painel do Supabase, Configurações da API), usada só no servidor para o disparo diário ler as cobranças de cada professor
SUPABASE_SERVICE_ROLE_KEY=
# Chave privada VAPID (segredo gerado junto com NEXT_PUBLIC_VAPID_PUBLIC_KEY, por exemplo com npx web-push generate-vapid-keys), usada só no servidor para assinar as notificações
VAPID_PRIVATE_KEY=
# Contato do dono do Quitô que vai junto de cada notificação (valor comum, ex.: mailto:contato@seudominio)
VAPID_SUBJECT=
